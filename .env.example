# Copie para .env e preencha. O .env nunca e commitado (veja .gitignore).
#   1. cp .env.example .env
#   2. preencha DB_USER, DB_PASSWORD, JWT_SECRET e CLOUDAMQP_URL
#   3. .\run.ps1   (PowerShell) ou rode pela IDE: o ConfiguracaoDotenv le o .env sozinho
#
# Oracle compartilhado do grupo na Azure (container no ACI). O grupo passa os valores por canal privado.
# Formato: jdbc:oracle:thin:@//<host>:1521/FREEPDB1
DB_URL=
DB_USER=
DB_PASSWORD=

# Segredo de assinatura dos JWT (>= 32 caracteres), IGUAL ao da API .NET.
# Gerar: openssl rand -base64 48
JWT_SECRET=
# Audience comum e emissores aceitos (a Java emite remembered-java; a .NET emite remembered-dotnet)
# JWT_AUDIENCE=remembered
# JWT_ISSUER=remembered-java
# JWT_ISSUERS_ACEITOS=remembered-java,remembered-dotnet

# Groq (console.groq.com/keys). Sem a chave, o relatorio de adesao sai so com os numeros.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# CloudAMQP: copie a AMQP URL do painel da instancia (amqps://usuario:senha@host/vhost)
CLOUDAMQP_URL=

# O banco da Azure e o mesmo da producao: na sua maquina, deixe os jobs e os consumidores desligados.
JOBS_HABILITADOS=false
RABBIT_CONSUMIDORES=false
